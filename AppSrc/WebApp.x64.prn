39170>>>    Procedure SetActionButtons
39173>>>        tWebNavigateData NavigateData
39173>>>        tWebNavigateData NavigateData
39173>>>        Boolean bHasRecord
39173>>>        Handle hoDD
39173>>>
39173>>>        Get Server to hoDD
39174>>>        Get GetNavigateData to NavigateData
39175>>>        Get HasRecord of hoDD to bHasRecord
39176>>>
39176>>>        // let's hide all buttons and then Show the ones we want
39176>>>        WebSet pbRender of oEditBtn to False
39177>>>        WebSet pbRender of oSaveBtn to False
39178>>>        WebSet pbRender of oCancelChangesBtn to False
39179>>>        WebSet pbRender of oDeleteBtn to False
39180>>>
39180>>>        If (NavigateData.bReadOnly) Begin
39182>>>            WebSet pbRender of oEditBtn to True
39183>>>        End
39183>>>>
39183>>>        Else Begin
39184>>>            WebSet pbRender of oSaveBtn to True
39185>>>            WebSet pbRender of oCancelChangesBtn to True
39186>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39187>>>        End
39187>>>>
39187>>>    End_Procedure
39188>>>
