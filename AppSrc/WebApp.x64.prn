38445>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38448>>>        WebSet pbRender of oNewButton to True
38449>>>        WebSet pbRender of oDetailButton to True
38450>>>
38450>>>        Case Begin
38450>>>            Case (NavigateData.eNavigateType = nfFromParent)
38452>>>                // If from parent, this is a constrained drill down
38452>>>                Case Break
38453>>>
38453>>>            Case (NavigateData.eNavigateType = nfFromChild)
38456>>>                // If from child, this is a probably a parent lookup from a Zoom
38456>>>                Case Break
38457>>>
38457>>>            Case (NavigateData.eNavigateType = nfFromMain)
38460>>>                // If from main, this is a probably a main-file lookup from a Zoom
38460>>>                WebSet pbRender of oDetailButton to False
38461>>>                Case Break
38462>>>
38462>>>            Case Else // must be nfUndefined
38462>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38462>>>
38462>>>        Case End
38462>>>
38462>>>    End_Procedure
38463>>>
38463>>>
38463>>>End_Object 
