37919>>>                // If from main, this is a propbably a main file Select to Zoom.
37919>>>                Case Break
37920>>>
37920>>>            Case (NavigateData.eNavigateType = nfFromParent)
37923>>>                // If from parent, this is a constrained drill down.
37923>>>                Case Break
37924>>>
37924>>>            Case (NavigateData.eNavigateType = nfFromChild)
37927>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37927>>>                Case Break
37928>>>
37928>>>            Case Else // must be nfUndefined
37928>>>
37928>>>        Case End
37928>>>
37928>>>        Send SetActionButtons
37929>>>
37929>>>    End_Procedure
37930>>>
37930>>>End_Object 
