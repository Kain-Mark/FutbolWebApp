38939>>>                // If from child, this is a probably a parent lookup from a Zoom
38939>>>                Case Break
38940>>>
38940>>>            Case (NavigateData.eNavigateType = nfFromMain)
38943>>>                // If from main, this is a probably a main-file lookup from a Zoom
38943>>>                WebSet pbRender of oDetailButton to False
38944>>>                Case Break
38945>>>
38945>>>            Case Else // must be nfUndefined
38945>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38945>>>
38945>>>        Case End
38945>>>
38945>>>    End_Procedure
