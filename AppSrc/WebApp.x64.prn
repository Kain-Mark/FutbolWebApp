39152>>>    Procedure SetActionButtons
39155>>>        tWebNavigateData NavigateData
39155>>>        tWebNavigateData NavigateData
39155>>>        Boolean bHasRecord
39155>>>        Handle hoDD
39155>>>
39155>>>        Get Server to hoDD
39156>>>        Get GetNavigateData to NavigateData
39157>>>        Get HasRecord of hoDD to bHasRecord
39158>>>
39158>>>        // let's hide all buttons and then Show the ones we want
39158>>>        WebSet pbRender of oEditBtn to False
39159>>>        WebSet pbRender of oSaveBtn to False
39160>>>        WebSet pbRender of oCancelChangesBtn to False
39161>>>        WebSet pbRender of oDeleteBtn to False
39162>>>
39162>>>        If (NavigateData.bReadOnly) Begin
39164>>>            WebSet pbRender of oEditBtn to True
39165>>>        End
39165>>>>
39165>>>        Else Begin
39166>>>            WebSet pbRender of oSaveBtn to True
39167>>>            WebSet pbRender of oCancelChangesBtn to True
39168>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39169>>>        End
39169>>>>
39169>>>    End_Procedure
