38104>>>>>>>            WebSet pbRender of oEditBtn to True
38105>>>>>>>        End
38105>>>>>>>>
38105>>>>>>>        Else Begin
38106>>>>>>>            WebSet pbRender of oSaveBtn to True
38107>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
38108>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38109>>>>>>>        End
