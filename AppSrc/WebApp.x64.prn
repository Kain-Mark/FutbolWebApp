38079>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38082>>>        WebSet pbRender of oNewButton to True
38083>>>        WebSet pbRender of oDetailButton to True
38084>>>
38084>>>        Case Begin
38084>>>            Case (NavigateData.eNavigateType = nfFromParent)
38086>>>                // If from parent, this is a constrained drill down
38086>>>                Case Break
38087>>>
38087>>>            Case (NavigateData.eNavigateType = nfFromChild)
38090>>>                // If from child, this is a probably a parent lookup from a Zoom
38090>>>                Case Break
38091>>>
38091>>>            Case (NavigateData.eNavigateType = nfFromMain)
38094>>>                // If from main, this is a probably a main-file lookup from a Zoom
38094>>>                WebSet pbRender of oDetailButton to False
38095>>>                Case Break
38096>>>
38096>>>            Case Else // must be nfUndefined
38096>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38096>>>
38096>>>        Case End
38096>>>
38096>>>    End_Procedure
