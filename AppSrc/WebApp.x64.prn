37609>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37612>>>        Case Begin
37612>>>            Case (NavigateData.eNavigateType = nfFromMain)
37614>>>                // If from main, this is a propbably a main file Select to Zoom.
37614>>>                Case Break
37615>>>
37615>>>            Case (NavigateData.eNavigateType = nfFromParent)
37618>>>                // If from parent, this is a constrained drill down.
37618>>>                Case Break
37619>>>
37619>>>            Case (NavigateData.eNavigateType = nfFromChild)
37622>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37622>>>                Case Break
37623>>>
37623>>>            Case Else // must be nfUndefined
37623>>>
37623>>>        Case End
37623>>>
37623>>>        Send SetActionButtons
37624>>>
37624>>>    End_Procedure
