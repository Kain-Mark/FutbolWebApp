37886>>>    Procedure SetActionButtons
37889>>>        tWebNavigateData NavigateData
37889>>>        tWebNavigateData NavigateData
37889>>>        Boolean bHasRecord
37889>>>        Handle hoDD
37889>>>
37889>>>        Get Server to hoDD
37890>>>        Get GetNavigateData to NavigateData
37891>>>        Get HasRecord of hoDD to bHasRecord
37892>>>
37892>>>        // let's hide all buttons and then Show the ones we want
37892>>>        WebSet pbRender of oEditBtn to False
37893>>>        WebSet pbRender of oSaveBtn to False
37894>>>        WebSet pbRender of oCancelChangesBtn to False
37895>>>        WebSet pbRender of oDeleteBtn to False
37896>>>
37896>>>        If (NavigateData.bReadOnly) Begin
37898>>>            WebSet pbRender of oEditBtn to True
37899>>>        End
37899>>>>
37899>>>        Else Begin
37900>>>            WebSet pbRender of oSaveBtn to True
37901>>>            WebSet pbRender of oCancelChangesBtn to True
37902>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37903>>>        End
37903>>>>
37903>>>    End_Procedure
