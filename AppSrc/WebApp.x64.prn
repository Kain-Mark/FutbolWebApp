39203>>>                // If from main, this is a propbably a main file Select to Zoom.
39203>>>                Case Break
39204>>>
39204>>>            Case (NavigateData.eNavigateType = nfFromParent)
39207>>>                // If from parent, this is a constrained drill down.
39207>>>                Case Break
39208>>>
39208>>>            Case (NavigateData.eNavigateType = nfFromChild)
39211>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39211>>>                Case Break
39212>>>
39212>>>            Case Else // must be nfUndefined
39212>>>
39212>>>        Case End
39212>>>
39212>>>        Send SetActionButtons
39213>>>
39213>>>    End_Procedure
39214>>>
39214>>>End_Object 
