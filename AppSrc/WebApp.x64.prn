37581>>>    Procedure SetActionButtons
37584>>>        tWebNavigateData NavigateData
37584>>>        tWebNavigateData NavigateData
37584>>>        Boolean bHasRecord
37584>>>        Handle hoDD
37584>>>
37584>>>        Get Server to hoDD
37585>>>        Get GetNavigateData to NavigateData
37586>>>        Get HasRecord of hoDD to bHasRecord
37587>>>
37587>>>        // let's hide all buttons and then Show the ones we want
37587>>>        WebSet pbRender of oEditBtn to False
37588>>>        WebSet pbRender of oSaveBtn to False
37589>>>        WebSet pbRender of oCancelChangesBtn to False
37590>>>        WebSet pbRender of oDeleteBtn to False
37591>>>
37591>>>        If (NavigateData.bReadOnly) Begin
37593>>>            WebSet pbRender of oEditBtn to True
37594>>>        End
37594>>>>
37594>>>        Else Begin
37595>>>            WebSet pbRender of oSaveBtn to True
37596>>>            WebSet pbRender of oCancelChangesBtn to True
37597>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37598>>>        End
